{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES6"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@seamless/tokens": ["packages/tokens/src"],
      "@seamless/ui": ["packages/ui/src"],
      "@seamless/layout": ["packages/layout/src"],
      "@seamless/saas": ["packages/saas/src"],
      "@seamless/ai": ["packages/ai/src"],
      "@seamless/themes": ["packages/themes/src"],
      "@seamless/blocks": ["packages/blocks/src"],
      "@seamless/registry": ["packages/registry/src"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}